// チェッカー
function setup() {
  createCanvas(200, 200);
  const size = width / 8; // マスの一辺の長さ
noStroke();
  for(let i = 0; i < 8; i++){
    for(let j = 0; j < 8; j++){
      if((i+j)%2==1){
        fill(100);
      }else{
        fill(255);
      }
    rect(j*size, i*size, size,size);
    }
  }

  for(let i=0;i<8;i++){
    for(let j=0;j<8;j++){
      if((i+j)%2==0){
        const cx = j * size + size/2;
        const cy = i * size + size/2;
        if(i<3){
          drawPiece(cx,cy,size*0.7,color(200,30,30));
        }else if(i>4){
          drawPiece(cx,cy,size*0.7,color(20));
        }
      }
    }
  }
}

function drawPiece(cx,cy,d,c){
  fill(c);
  stroke(255,255,255.120);
  ellipse(cx,cy,d,d); 
}
